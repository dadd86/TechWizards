<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Tema base para Compose (Material 3). Sin ActionBar. -->
    <style name="Theme.TechWizards" parent="Theme.Material3.DayNight.NoActionBar" />
    <!-- Tema de SplashScreen para evitar parpadeos al aplicar locale. -->
