rules_version='2'

service cloud.firestore {
  match /databases/{database}/documents {
    function hasValidPrizeShape() {
      return request.resource.data.keys().hasOnly([
        "descripcion",
        "valor",
        "updatedAt",
        "updatedByUid",
        "lastWinnerUid",
        "lastWinnerAlias",
        "lastClaimId",
        "lastClaimAt",
        "lastClaimAmount",
        "lastClaimedAt",
        "lastClaimedByUid"
      ]);
    }

    function isValidPrizeValueUpdate() {
      return request.resource.data.valor is int
        && request.resource.data.valor >= 0
        && (resource.data.valor is int ? (
          request.resource.data.valor == 0 ||
          request.resource.data.valor >= resource.data.valor
        ) : request.resource.data.valor >= 0);
    }

    function isValidPrizeDescription() {
      return (request.resource.data.descripcion is string
        ? request.resource.data.descripcion
        : resource.data.descripcion) is string
        && (request.resource.data.descripcion is string
          ? request.resource.data.descripcion.size()
          : resource.data.descripcion.size()) <= 120;
    }

    match /players/{userId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == userId;

      match /history/{historyId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }
    match /prize/common {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && hasValidPrizeShape()
        && isValidPrizeDescription()
        && isValidPrizeValueUpdate();
      allow update: if request.auth != null
        && hasValidPrizeShape()
        && isValidPrizeDescription()
        && isValidPrizeValueUpdate();
    }
  }
}
